# Local dev: your standalone Express server, API mounted at /api
VITE_API_BASE_URL=http://localhost:5010/api

# Production (Vercel, single project with services): leave this as the relative
# path below so requests stay same-origin and go through the project's rewrite
# to the "server" service - no CORS needed, no server URL to hardcode.
# VITE_API_BASE_URL=/api
